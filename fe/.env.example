# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (neon.tech → project → connection details).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# better-auth: a long random string (e.g. `openssl rand -base64 32`) and the
# public URL of this app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# Google OAuth client (console.cloud.google.com/apis/credentials, type "Web
# application", redirect URI http://localhost:3010/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Leo extension's origin, so its sign-out POST passes better-auth's CSRF
# check. Find the id on chrome://extensions.
EXTENSION_ORIGIN=chrome-extension://<extension-id>

# AI for repair, AI steps and workflow naming. Keys stay on the server; the
# extension calls /api/ai/* with the user's session. Set one of:
ANTHROPIC_API_KEY=
# Groq (OpenAI-compatible; default model openai/gpt-oss-120b, text-only —
# the agent works from the page's element list instead of screenshots).
GROQ_API_KEY=
# Optional: force a provider (anthropic | groq) and/or a model.
# LEO_AI_PROVIDER=groq
# LEO_AI_MODEL=openai/gpt-oss-120b
